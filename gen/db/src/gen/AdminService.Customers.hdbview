VIEW AdminService_Customers AS SELECT
  Customer_0.customerID,
  Customer_0.firstName,
  Customer_0.lastName,
  Customer_0.email,
  Customer_0.phone,
  Customer_0.statusCode_code,
  Customer_0.averageRating,
  Customer_0.categoryGroup,
  statusCode_1.criticality AS criticality
FROM (crm_Customer AS Customer_0 LEFT JOIN crm_CustomerStatusCode AS statusCode_1 ON Customer_0.statusCode_code = statusCode_1.code)