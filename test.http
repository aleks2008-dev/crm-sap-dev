# =============================================================================
# ADMIN SERVICE — Full Functionality Demo
# Base URL: http://localhost:4004
# Auth:     admin / (empty password)  →  Basic YWRtaW46
# Run:      CDS_REQUIRES_AUTH_KIND=mocked cds watch --profile hybrid
# =============================================================================


# -----------------------------------------------------------------------------
# SECTION 0 — Seed Data (run once if test customers don't exist in HANA)
# -----------------------------------------------------------------------------

### 0.1 POST - Create seed customer Alex Brown (Active)
POST http://localhost:4004/admin/Customers
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "customerID": "33333333-3333-3333-3333-333333333333",
  "firstName": "Alex",
  "lastName": "Brown",
  "email": "alex.brown@example.com",
  "phone": "+79990001122",
  "statusCode_code": "Active",
  "averageRating": 0.00
}

###

### 0.2 POST - Activate Alex Brown draft
POST http://localhost:4004/admin/Customers(33333333-3333-3333-3333-333333333333)/AdminService.draftActivate
Authorization: Basic YWRtaW46
Content-Type: application/json

{}

###

### 0.3 POST - Create seed customer Emma Watson (At-Risk)
POST http://localhost:4004/admin/Customers
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "customerID": "44444444-4444-4444-4444-444444444444",
  "firstName": "Emma",
  "lastName": "Watson",
  "email": "emma.w@example.com",
  "phone": "+1234567890",
  "statusCode_code": "At-Risk",
  "averageRating": 2.50
}


# -----------------------------------------------------------------------------
# SECTION 1 — Customer Management (CRUD)
# -----------------------------------------------------------------------------

### 1.1 GET - List all customers
GET http://localhost:4004/admin/Customers
Authorization: Basic YWRtaW46

###

### 1.2 GET - Get a specific customer by ID
GET http://localhost:4004/admin/Customers(44444444-4444-4444-4444-444444444444)
Authorization: Basic YWRtaW46

###

### 1.3 POST - Create a new customer
POST http://localhost:4004/admin/Customers
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@example.com",
  "phone": "+1987654321",
  "statusCode_code": "Active",
  "averageRating": 0.00
}


# -----------------------------------------------------------------------------
# SECTION 2 — Feedbacks (created via SalesService, not AdminService)
# NOTE: Feedbacks are a child of draft-enabled Customers in AdminService,
#       so they must be created through /sales/Feedbacks endpoint.
#       See sales_test.http Section 2 for feedback creation.
# -----------------------------------------------------------------------------

### 2.1 GET - List all feedbacks (read via AdminService)
GET http://localhost:4004/admin/Feedbacks
Authorization: Basic YWRtaW46

###

### 2.2 GET - List all interactions
GET http://localhost:4004/admin/Interactions
Authorization: Basic YWRtaW46


# -----------------------------------------------------------------------------
# SECTION 3 — Custom Actions: Rating & Status
# Run Section 2 in sales_test.http first to have feedbacks in the database
# -----------------------------------------------------------------------------

### 3.1 ACTION - Calculate average rating for a customer
# Reads all feedbacks, computes average, updates Customer.averageRating
POST http://localhost:4004/admin/calculateAverageRating
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "customerID": "33333333-3333-3333-3333-333333333333"
}

###

### 3.2 ACTION - Update customer status based on activity and rating
# Logic: averageRating < 3 → At-Risk | recent interaction → Active | else → Inactive
POST http://localhost:4004/admin/updateCustomerStatus
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "customerID": "33333333-3333-3333-3333-333333333333"
}

###

### 3.3 ACTION - Update status for the At-Risk customer (Emma Watson, rating 2.5)
# Expected result: status remains At-Risk due to low rating
POST http://localhost:4004/admin/updateCustomerStatus
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "customerID": "44444444-4444-4444-4444-444444444444"
}

###

### 3.4 ACTION - 404 test: update status for a non-existent customer
POST http://localhost:4004/admin/updateCustomerStatus
Authorization: Basic YWRtaW46
Content-Type: application/json

{
  "customerID": "00000000-0000-0000-0000-000000000000"
}


