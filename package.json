{
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.16.0",
    "@cap-js/sqlite": "^2.4.0",
    "@types/node": "^24.0.0",
    "sqlite3": "^6.0.1",
    "tsx": "^4",
    "typescript": "^5.4.5"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy",
          "users": {
            "admin": {
              "roles": [
                "CRM-Admin"
              ]
            },
            "sales": {
              "roles": [
                "CRM-Sales"
              ]
            },
            "support": {
              "roles": [
                "CRM-Support"
              ]
            }
          }
        }
      }
    }
  }
}
