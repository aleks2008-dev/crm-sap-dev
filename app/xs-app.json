{
  "welcomeFile": "/projectcrm/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/admin/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/sales/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/support/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/orders/(.*)$",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/$",
      "target": "/projectcrm/index.html",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/projectcrm/(.*)$",
      "target": "/projectcrm/$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/project_orders/(.*)$",
      "target": "/project_orders/$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/project_orders_ui5/(.*)$",
      "target": "/project_orders_ui5/$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": ".",
      "authenticationType": "xsuaa"
    }
  ]
}
