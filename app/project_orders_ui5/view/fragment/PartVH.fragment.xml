<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        title="Select Mechanical Part"
        search=".onPartVHSearch"
        confirm=".onPartVHConfirm"
        cancel=".onPartVHCancel"
        items="{ path: 'orderModel>/MechanicalParts' }">
        <StandardListItem
            title="{orderModel>name}"
            description="{orderModel>description}"
            info="{ path: 'orderModel>price', formatter: '.formatter.formatCurrency' }"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>
