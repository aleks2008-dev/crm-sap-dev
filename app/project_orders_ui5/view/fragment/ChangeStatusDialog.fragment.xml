<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="changeStatusDialog" title="Change Status" type="Message">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="New Status" required="true" />
                <ComboBox id="newStatusCombo" width="100%"
                    items="{ path: 'orderModel>/OrderStatusCodes' }"
                    tooltip="Select the new order status">
                    <core:Item key="{orderModel>code}" text="{orderModel>name}" />
                </ComboBox>
                <Label text="Comment" class="sapUiTinyMarginTop" />
                <TextArea id="statusComment" width="100%" rows="3"
                    tooltip="Optional comment for status change" />
            </VBox>
        </content>
        <beginButton>
            <Button text="OK" type="Emphasized" press=".onConfirmChangeStatus" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelChangeStatus" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
