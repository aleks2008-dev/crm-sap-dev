<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="customerSelectDialog"
        title="Select Customer"
        search=".onCustomerVHSearch"
        confirm=".onCustomerVHConfirm"
        cancel=".onCustomerVHCancel"
        confirmButtonText="Select"
        items="{ path: 'orderModel>/Customers' }">
        <StandardListItem
            title="{orderModel>fullName}"
            description="{orderModel>email}"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>
