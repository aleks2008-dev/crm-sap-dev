{
  "xsappname": "crm_sap_dev",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://f0a4dd9etrial-dev-crm-sap-dev-app.cfapps.us10-001.hana.ondemand.com/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.CRM-Admin",
      "description": "CRM Admin Scope"
    },
    {
      "name": "$XSAPPNAME.CRM-Sales",
      "description": "CRM Sales Scope"
    },
    {
      "name": "$XSAPPNAME.CRM-Support",
      "description": "CRM Support Scope"
    }
  ],
  "role-templates": [
    {
      "name": "CRM-Admin",
      "description": "Full access",
      "scope-references": ["$XSAPPNAME.CRM-Admin"]
    },
    {
      "name": "CRM-Sales",
      "description": "View and update customers, log interactions",
      "scope-references": ["$XSAPPNAME.CRM-Sales"]
    },
    {
      "name": "CRM-Support",
      "description": "Read-only access",
      "scope-references": ["$XSAPPNAME.CRM-Support"]
    }
  ],
  "role-collections": [
    {
      "name": "CRM-Admin-RC",
      "description": "CRM Admin Role Collection",
      "role-template-references": [
        "$XSAPPNAME.CRM-Admin",
        "$XSAPPNAME.CRM-Sales",
        "$XSAPPNAME.CRM-Support"
      ]
    },
    {
      "name": "CRM-Sales-RC",
      "description": "CRM Sales Role Collection",
      "role-template-references": [
        "$XSAPPNAME.CRM-Sales"
      ]
    },
    {
      "name": "CRM-Support-RC",
      "description": "CRM Support Role Collection",
      "role-template-references": [
        "$XSAPPNAME.CRM-Support"
      ]
    }
  ]
}
