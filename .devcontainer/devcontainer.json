{
    "name": "CRM SAP CAP - dev container",
    "build": {
      "dockerfile": "Dockerfile",
      "args": {
        "VARIANT": "20"
      }
    },
    "customizations": {
      "vscode": {
        "extensions": [
          "sapse.vscode-cds",
          "dbaeumer.vscode-eslint",
          "humao.rest-client",
          "qwtel.sqlite-viewer",
          "mechatroner.rainbow-csv"
        ]
      }
    },
    "forwardPorts": [4004, 8080],
    "portsAttributes": {
      "4004": {
        "label": "CAP OData",
        "onAutoForward": "notify"
      },
      "8080": {
        "label": "UI5 App",
        "onAutoForward": "notify"
      }
    },
    "postCreateCommand": "node -v && cds -v",
    "remoteUser": "node"
  }